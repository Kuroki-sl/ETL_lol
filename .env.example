#ID de usuario para contenedores de Airflow
AIRFLOW_UID=50000

# PostgreSQL de datos incluido en Docker Compose
PGHOST=lol-postgres
PGPORT=5432
PGDATABASE=gestion_lol
PGUSER=postgres
PGPASSWORD=tu_contrasena_postgres

# Clave de cifrado de Airflow; generarla con el comando del README
FERNET_KEY=

#API key de Riot Games
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

RIOT_API_BASE_AMERICAS=https://americas.api.riotgames.com
RIOT_API_BASE_LAS=https://la2.api.riotgames.com
