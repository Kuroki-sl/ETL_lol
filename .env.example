# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa con tus valores reales.
# IMPORTANTE: NUNCA subas el archivo .env con contraseñas o API Keys reales al repositorio o entrega.
# ============================================================================

# ID de usuario para contenedores de Airflow (en Linux/WSL2 estándar es 50000)
AIRFLOW_UID=50000

# Conexión a PostgreSQL (host.docker.internal apunta al PostgreSQL en Windows)
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=gestion_lol
PGUSER=postgres
PGPASSWORD=tu_contrasena_postgres

# Clave de la API de Riot Games (obtenida en https://developer.riotgames.com)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Servidores regionales de Riot API
RIOT_API_BASE_AMERICAS=https://americas.api.riotgames.com
RIOT_API_BASE_LAS=https://la2.api.riotgames.com
